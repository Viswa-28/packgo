---
import site from '../content/site.json';
import testimonials from '../content/testimonials.json';
import Icon from './Icon.astro';

const { testimonialsSection: t, contact } = site;

// No invented reviews. Until testimonials.json has a real entry, this section
// renders the Instagram trust block instead — same job, honestly.
type Review = { quote: string; name: string; city?: string; trip?: string; rating?: number };
const reviews = testimonials as Review[];
const hasReviews = reviews.length > 0;
---

<section id="reviews" class="bg-navy py-14 text-soft md:py-20">
  <div class="container-x">
    <p class="section-label text-sky">{t.label}</p>

    {
      hasReviews ? (
        <>
          <h2 class="reveal mt-3 text-[2rem] sm:text-4xl">{t.heading}</h2>
          <ul class="reveal-group mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {reviews.map((r) => (
              <li class="flex flex-col rounded-card border border-soft/15 bg-navy-mid/35 p-6">
                {r.rating && (
                  <p
                    class="flex gap-0.5 text-sky"
                    aria-label={`Rated ${r.rating} out of 5`}
                    role="img"
                  >
                    {Array.from({ length: r.rating }).map(() => (
                      <Icon name="star" size={16} />
                    ))}
                  </p>
                )}
                <blockquote class="mt-3 flex-1 text-[1.0625rem] leading-relaxed text-soft/90">
                  “{r.quote}”
                </blockquote>
                <footer class="mt-5 border-t border-soft/15 pt-4">
                  <p class="font-semibold text-soft">
                    {r.name}
                    {r.city && <span class="font-normal text-soft/70">, {r.city}</span>}
                  </p>
                  {r.trip && <p class="mt-0.5 text-sm text-sky">{r.trip}</p>}
                </footer>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <div class="reveal mt-3 grid gap-6 rounded-card border border-soft/15 bg-navy-mid/35 p-7 md:grid-cols-[1fr_auto] md:items-center md:gap-10 md:p-9">
          <div>
            <h2 class="text-[2rem] sm:text-4xl">{t.fallbackHeading}</h2>
            <p class="mt-3 max-w-xl text-[1.0625rem] text-soft/80">{t.fallbackBody}</p>
          </div>
          <a
            href={contact.instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn-base shrink-0 bg-blue-deep text-white hover:bg-blue"
          >
            <Icon name="instagram" size={18} />
            {t.fallbackCta}
          </a>
        </div>
      )
    }
  </div>
</section>

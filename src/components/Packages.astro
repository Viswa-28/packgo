---
import site from '../content/site.json';
import packages from '../content/packages.json';
import PackageCard from './PackageCard.astro';

const { packagesSection } = site;
---

<section id="packages" class="bg-cream-dim py-14 md:py-20">
  <div class="container-x">
    <div class="reveal">
      <p class="section-label text-gold-deep">{packagesSection.label}</p>
      <h2 class="mt-3 max-w-xl text-[2rem] text-forest sm:text-4xl">
        {packagesSection.heading}
      </h2>
      <p class="mt-4 max-w-2xl text-[1.0625rem] text-ink/75">{packagesSection.intro}</p>
    </div>

    <div class="reveal-group mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {packages.map((pkg) => <PackageCard pkg={pkg} />)}
    </div>
  </div>
</section>

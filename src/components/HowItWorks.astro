---
import site from '../content/site.json';
import Icon from './Icon.astro';

const { howItWorks } = site;
---

<section id="how-it-works" class="bg-soft-dim py-14 md:py-20">
  <div class="container-x">
    <div class="reveal">
      <p class="section-label text-blue-deep">{howItWorks.label}</p>
      <h2 class="mt-3 max-w-xl text-[2rem] text-navy sm:text-4xl">{howItWorks.heading}</h2>
    </div>

    <ol class="reveal-group mt-10 grid gap-5 md:grid-cols-3">
      {
        howItWorks.steps.map((step, i) => (
          <li class="relative rounded-card border border-navy/10 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-blue-deep font-display text-xl text-white">
                {i + 1}
              </span>
              <Icon name={step.icon} size={22} class="text-navy-mid" />
            </div>
            <h3 class="mt-4 text-xl text-navy">{step.heading}</h3>
            <p class="mt-2 text-[0.9375rem] text-ink/75">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

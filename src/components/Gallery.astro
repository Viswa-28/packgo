---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import site from '../content/site.json';
import galleryData from '../content/gallery.json';

const { gallerySection } = site;

type Shot = { file: string; alt: string };
const shots = galleryData as Shot[];

// Photos live in src/assets/gallery/ so Astro compresses them to WebP and
// stamps explicit width/height at build time.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpg,jpeg,png,webp,avif}'
);

const items = shots
  .map((shot) => ({ shot, loader: files[`/src/assets/gallery/${shot.file}`] }))
  .filter((item) => Boolean(item.loader) && Boolean(item.shot.alt));

const resolved = await Promise.all(
  items.map(async ({ shot, loader }) => ({ shot, image: (await loader()).default }))
);
---

{
  resolved.length > 0 && (
    <section id="gallery" class="bg-soft py-14 md:py-20">
      <div class="container-x">
        <div class="reveal">
          <p class="section-label text-blue-deep">{gallerySection.label}</p>
          <h2 class="mt-3 text-[2rem] text-navy sm:text-4xl">{gallerySection.heading}</h2>
        </div>

        <ul class="reveal-group mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {resolved.map(({ shot, image }, i) => (
            <li class="overflow-hidden rounded-card bg-soft-dim">
              <Image
                src={image}
                alt={shot.alt}
                widths={[300, 600]}
                sizes="(min-width: 1024px) 280px, (min-width: 640px) 32vw, 48vw"
                format="webp"
                quality={70}
                loading="lazy"
                decoding="async"
                class="aspect-4/3 h-auto w-full object-cover transition-transform duration-300 hover:scale-105"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

---
import Icon from './Icon.astro';
import { wa } from '../lib/contact';

interface Props {
  place: {
    id: string;
    name: string;
    region: string;
    scope: 'international' | 'india';
    categories: string[];
    tagline: string;
    highlights: string[];
    bestTime?: string;
    message: string;
  };
  /** id -> short label, so the card can print category chips without re-reading JSON. */
  labels: Record<string, string>;
  /** id -> icon name, for the marker in the card header. */
  icons: Record<string, string>;
}

const { place, labels, icons } = Astro.props;
const lead = place.categories[0];
---

{/* `data-cat` is what the CSS-only category filter in Destinations.astro matches
    on with [data-cat~="food"] — one attribute, no JavaScript. */}
<article
  class="dest-card flex flex-col overflow-hidden rounded-card border border-navy/10 bg-white shadow-sm transition-shadow duration-200 hover:shadow-lg"
  data-cat={place.categories.join(' ')}
>
  <div class="relative bg-navy px-5 pt-5 pb-4 text-soft">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-[0.16]"
      style="background-image:radial-gradient(circle at 1px 1px,#55C2FF 1px,transparent 0);background-size:22px 22px;"
    >
    </div>

    <div class="relative flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h3 class="text-2xl leading-tight">{place.name}</h3>
        <p class="mt-1 flex items-center gap-1.5 text-sm text-soft/75">
          <Icon name="pin" size={14} class="shrink-0" />
          {place.region}
        </p>
      </div>
      <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-navy-mid text-sky">
        <Icon name={icons[lead] ?? 'globe'} size={20} />
      </span>
    </div>

    <p class="relative mt-3 text-[0.9375rem] text-soft/85">{place.tagline}</p>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <ul class="flex flex-wrap gap-1.5">
      <li
        class="rounded-full bg-navy px-2.5 py-1 text-[0.875rem] font-semibold tracking-[0.08em] text-sky uppercase"
      >
        {place.scope === 'international' ? 'International' : 'India'}
      </li>
      {
        place.categories.map((id) => (
          <li class="rounded-full bg-soft-dim px-2.5 py-1 text-[0.875rem] font-semibold tracking-[0.08em] text-navy uppercase">
            {labels[id] ?? id}
          </li>
        ))
      }
    </ul>

    <ul class="mt-4 space-y-2.5 text-[0.9375rem]">
      {
        place.highlights.map((line) => (
          <li class="flex items-start gap-2.5">
            <Icon name="check" size={17} strokeWidth={2.5} class="mt-0.5 shrink-0 text-blue-deep" />
            <span class="text-ink/80">{line}</span>
          </li>
        ))
      }
    </ul>

    {
      place.bestTime && (
        <p class="mt-4 flex items-center gap-2 text-[0.875rem] font-medium text-muted">
          <Icon name="calendar" size={16} class="shrink-0 text-blue-deep" />
          Best time: {place.bestTime}
        </p>
      )
    }

    <div class="mt-auto pt-5">
      <a
        href={wa(place.message)}
        target="_blank"
        rel="noopener"
        class="btn-base w-full border-2 border-navy text-navy hover:bg-navy hover:text-soft"
      >
        <Icon name="whatsapp" size={18} />
        Enquire on WhatsApp
      </a>
    </div>
  </div>
</article>

---
import { Image } from 'astro:assets';
import site from '../content/site.json';
import Icon from './Icon.astro';
import logo from '../assets/logo.png';
import { wa, tel, phone, altTel, altPhone, whatsappDisplay } from '../lib/contact';

const { brand, contact, footer } = site;

// Address, email and hours only appear once the owner has filled them in.
const hasAddress = Boolean(contact.streetAddress);

const legalLinks = footer.legalLinks as { label: string; href: string }[];
---

<footer class="bg-navy pt-14 pb-28 text-soft/80 md:pb-12">
  <div class="container-x">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <Image
          src={logo}
          alt={`${brand.name} logo`}
          width={201}
          height={60}
          densities={[1, 2]}
          loading="lazy"
          class="h-12 w-auto"
        />
        <p class="mt-3 text-[0.9375rem] text-sky">{brand.tagline}</p>
        <address class="mt-4 text-[0.9375rem] not-italic">
          {hasAddress && <span class="block">{contact.streetAddress}</span>}
          <span class="block">
            {contact.addressLocality}, {contact.addressRegion}
          </span>
          {contact.postalCode && <span class="block">{contact.postalCode}</span>}
        </address>
      </div>

      <nav aria-label="Footer">
        <h2 class="font-display text-lg tracking-wide text-soft">{footer.quickLinksHeading}</h2>
        <ul class="mt-3 space-y-1">
          {
            footer.quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center text-[0.9375rem] transition-colors hover:text-sky"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-display text-lg tracking-wide text-soft">{footer.contactHeading}</h2>
        <ul class="mt-3 space-y-1">
          <li>
            <a
              href={tel}
              class="inline-flex min-h-11 items-center gap-2.5 text-[0.9375rem] transition-colors hover:text-sky"
            >
              <Icon name="phone" size={17} class="shrink-0 text-sky" />
              {phone}
            </a>
          </li>
          {
            altPhone && (
              <li>
                <a
                  href={altTel}
                  class="inline-flex min-h-11 items-center gap-2.5 text-[0.9375rem] transition-colors hover:text-sky"
                >
                  <Icon name="phone" size={17} class="shrink-0 text-sky" />
                  {altPhone}
                </a>
              </li>
            )
          }
          <li>
            <a
              href={wa(`Hi ${brand.name}, I have a question.`)}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center gap-2.5 text-[0.9375rem] transition-colors hover:text-sky"
            >
              <Icon name="whatsapp" size={17} class="shrink-0 text-sky" />
              WhatsApp {whatsappDisplay}
            </a>
          </li>
          {
            contact.email && (
              <li>
                <a
                  href={`mailto:${contact.email}`}
                  class="inline-flex min-h-11 items-center gap-2.5 text-[0.9375rem] transition-colors hover:text-sky"
                >
                  <Icon name="mail" size={17} class="shrink-0 text-sky" />
                  {contact.email}
                </a>
              </li>
            )
          }
          <li>
            <a
              href={contact.instagramUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center gap-2.5 text-[0.9375rem] transition-colors hover:text-sky"
            >
              <Icon name="instagram" size={17} class="shrink-0 text-sky" />
              @{contact.instagramHandle}
            </a>
          </li>
        </ul>
      </div>

      {
        contact.hoursDisplay && (
          <div>
            <h2 class="font-display text-lg tracking-wide text-soft">{footer.hoursHeading}</h2>
            <p class="mt-3 flex items-start gap-2.5 text-[0.9375rem]">
              <Icon name="clock" size={17} class="mt-1 shrink-0 text-sky" />
              {contact.hoursDisplay}
            </p>
          </div>
        )
      }
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-soft/15 pt-6 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p>{footer.copyright}</p>
      {
        legalLinks.length > 0 && (
          <ul class="flex gap-5">
            {legalLinks.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-sky">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>

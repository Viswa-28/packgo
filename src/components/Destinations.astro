---
import site from '../content/site.json';
import data from '../content/destinations.json';
import DestinationCard from './DestinationCard.astro';
import Icon from './Icon.astro';
import { wa } from '../lib/contact';

const { destinationsSection } = site;
const { categories, places } = data;

const labels = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const icons = Object.fromEntries(categories.map((c) => [c.id, c.icon]));

const chips = [
  { id: 'all', label: 'All', icon: 'globe', count: places.length },
  ...categories.map((c) => ({
    id: c.id,
    label: c.label,
    icon: c.icon,
    count: places.filter((p) => p.categories.includes(c.id)).length,
  })),
];

/**
 * The category filter is CSS, not JavaScript: a radio group plus one `:has()`
 * rule per category. Browsers without `:has()` (pre-2023 WebViews) never match
 * the hide rule, so every card stays on the page — and the rule below hides the
 * filter bar there rather than leaving dead chips.
 */
const filterCss =
  categories
    .map(
      (c) =>
        `.dest-filter:has(#dest-cat-${c.id}:checked) .dest-card:not([data-cat~="${c.id}"]){display:none}`
    )
    .join('') +
  // The active chip is a plain adjacent-sibling rule, not another `:has()` one.
  // Chrome's `:has()` invalidation doesn't reach the changed input's own
  // siblings, so a `:has()` version filtered the cards correctly but left the
  // chips stuck on their initial state after a real click.
  `.dest-bar input:checked+label{background:var(--color-navy);color:var(--color-soft);border-color:var(--color-navy)}` +
  `.dest-bar input:focus-visible+label{outline:3px solid var(--color-blue);outline-offset:3px}` +
  `@supports not selector(:has(*)){.dest-bar{display:none}}`;
---

<section id="destinations" class="bg-soft-dim py-14 md:py-20">
  <div class="container-x">
    <div class="reveal">
      <p class="section-label text-blue-deep">{destinationsSection.label}</p>
      <h2 class="mt-3 max-w-2xl text-[2rem] text-navy sm:text-4xl">
        {destinationsSection.heading}
      </h2>
      <p class="mt-4 max-w-2xl text-[1.0625rem] text-ink/75">{destinationsSection.intro}</p>
    </div>

    <div class="dest-filter mt-8">
      {/* min-w-0: a <fieldset> defaults to `min-inline-size: min-content`, so
          without this the chip row's intrinsic width drags the whole page past
          360px instead of scrolling inside its own container. */}
      <fieldset class="dest-bar min-w-0">
        <legend class="sr-only">{destinationsSection.filterLegend}</legend>
        {/* Wrapping, not a horizontal scroller: the whole point of the section is
            that you can see every category at a glance, and a phone-width
            scroller hides the last two or three behind an edge. `relative` is
            load-bearing — the sr-only radio is absolutely positioned, and
            without a positioned parent it resolves against the viewport and
            drags the page's scrollable width out with it. */}
        <div class="flex flex-wrap gap-2">
          {
            chips.map((chip) => (
              <div class="relative">
                <input
                  type="radio"
                  name="dest-cat"
                  id={`dest-cat-${chip.id}`}
                  class="sr-only"
                  checked={chip.id === 'all'}
                />
                <label
                  for={`dest-cat-${chip.id}`}
                  class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-navy/15 bg-white px-4 text-[0.9375rem] font-semibold text-navy transition-colors hover:border-blue"
                >
                  <Icon name={chip.icon} size={17} class="shrink-0" />
                  {chip.label}
                  <span class="text-[0.875rem] font-medium opacity-65">{chip.count}</span>
                </label>
              </div>
            ))
          }
        </div>
      </fieldset>

      <div class="reveal-group mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {places.map((place) => <DestinationCard place={place} labels={labels} icons={icons} />)}
      </div>
    </div>

    <div
      class="reveal mt-8 flex flex-col gap-4 rounded-card bg-navy p-6 text-soft sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h3 class="text-2xl">{destinationsSection.custom.heading}</h3>
        <p class="mt-2 max-w-xl text-[0.9375rem] text-soft/85">
          {destinationsSection.custom.body}
        </p>
      </div>
      <a
        href={wa(destinationsSection.custom.message)}
        target="_blank"
        rel="noopener"
        class="btn-base shrink-0 bg-blue-deep text-white hover:bg-blue"
      >
        <Icon name="whatsapp" size={18} />
        {destinationsSection.custom.cta}
      </a>
    </div>
  </div>
</section>

<style is:inline set:html={filterCss}></style>

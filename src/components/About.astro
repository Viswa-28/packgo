---
import site from '../content/site.json';

const { about } = site;
---

<section id="about" class="bg-cream py-14 md:py-20">
  <div class="container-x grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-start lg:gap-16">
    <div class="reveal">
      <p class="section-label text-gold-deep">{about.label}</p>
      <h2 class="mt-3 max-w-lg text-[2rem] text-forest sm:text-4xl">{about.heading}</h2>

      <div class="mt-5 space-y-4 text-[1.0625rem] text-ink/85">
        {about.body.map((para) => <p>{para}</p>)}
      </div>
    </div>

    {
      about.stats.length > 0 && (
        <ul class="reveal-group grid grid-cols-2 gap-3 sm:gap-4">
          {about.stats.map((stat) => (
            <li class="rounded-card border border-forest/10 bg-white p-5 shadow-sm">
              <p class="font-display text-4xl text-forest sm:text-5xl">{stat.value}</p>
              <p class="mt-1.5 text-sm leading-snug text-muted">{stat.label}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

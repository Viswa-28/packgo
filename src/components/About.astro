---
import site from '../content/site.json';
import destinations from '../content/destinations.json';

const { about } = site;

// A stat can carry `count: "places" | "categories"` instead of a literal
// `value`, so the tiles stay true when the owner edits destinations.json.
const counts: Record<string, number> = {
  places: destinations.places.length,
  categories: destinations.categories.length,
};
const stats = about.stats.map((stat) => ({
  label: stat.label,
  value: 'count' in stat ? String(counts[stat.count as string] ?? '') : stat.value,
}));
---

<section id="about" class="bg-soft py-14 md:py-20">
  <div class="container-x grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-start lg:gap-16">
    <div class="reveal">
      <p class="section-label text-blue-deep">{about.label}</p>
      <h2 class="mt-3 max-w-lg text-[2rem] text-navy sm:text-4xl">{about.heading}</h2>

      <div class="mt-5 space-y-4 text-[1.0625rem] text-ink/85">
        {about.body.map((para) => <p>{para}</p>)}
      </div>
    </div>

    {
      stats.length > 0 && (
        <ul class="reveal-group grid grid-cols-2 gap-3 sm:gap-4">
          {stats.map((stat) => (
            <li class="rounded-card border border-navy/10 bg-white p-5 shadow-sm">
              <p class="font-display text-4xl text-navy sm:text-5xl">{stat.value}</p>
              <p class="mt-1.5 text-sm leading-snug text-muted">{stat.label}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

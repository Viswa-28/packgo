---
import site from '../content/site.json';
import Icon from './Icon.astro';
import { wa } from '../lib/contact';

const { rentals } = site;
---

<section id="rentals" class="bg-navy py-14 text-soft md:py-20">
  <div class="container-x">
    <div class="reveal">
      <p class="section-label text-sky">{rentals.label}</p>
      <h2 class="mt-3 text-[2rem] sm:text-4xl">{rentals.heading}</h2>
      <p class="mt-4 max-w-2xl text-[1.0625rem] text-soft/80">{rentals.body}</p>
    </div>

    <ul class="reveal-group mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        rentals.features.map((f) => (
          <li class="rounded-card border border-soft/15 bg-navy-mid/35 p-6">
            <span class="grid size-12 place-items-center rounded-xl bg-blue-deep text-white">
              <Icon name={f.icon} size={24} />
            </span>
            <h3 class="mt-4 text-xl text-soft">{f.heading}</h3>
            <p class="mt-2 text-[0.9375rem] text-soft/80">{f.text}</p>
          </li>
        ))
      }
    </ul>

    <div
      class="reveal mt-8 flex flex-col gap-5 rounded-card border border-soft/15 p-6 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h3 class="text-lg text-sky">{rentals.requirementsHeading}</h3>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
          {
            rentals.requirements.map((req) => (
              <li class="flex items-center gap-2 text-[0.9375rem] text-soft/85">
                <Icon name="check" size={16} strokeWidth={2.5} class="shrink-0 text-sky" />
                {req}
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={wa(rentals.cta.message)}
        target="_blank"
        rel="noopener"
        class="btn-base shrink-0 bg-blue-deep text-white hover:bg-blue"
      >
        <Icon name="whatsapp" size={18} />
        {rentals.cta.label}
      </a>
    </div>
  </div>
</section>

---
import site from '../content/site.json';
import Icon from './Icon.astro';

const { whyUs } = site;
---

<section id="why-us" class="bg-cream py-14 md:py-20">
  <div class="container-x">
    <div class="reveal">
      <p class="section-label text-gold-deep">{whyUs.label}</p>
      <h2 class="mt-3 max-w-xl text-[2rem] text-forest sm:text-4xl">{whyUs.heading}</h2>
    </div>

    <ul class="reveal-group mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        whyUs.items.map((item) => (
          <li class="rounded-card border border-forest/10 bg-white p-6 shadow-sm">
            <span class="grid size-11 place-items-center rounded-xl bg-forest text-gold">
              <Icon name={item.icon} size={22} />
            </span>
            <h3 class="mt-4 text-xl text-forest">{item.heading}</h3>
            <p class="mt-2 text-[0.9375rem] text-ink/75">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
